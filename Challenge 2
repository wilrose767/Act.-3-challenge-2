# Binary Search

numbers = [2, 5, 8, 12, 16, 20, 25, 30]
target = 20

left = 0
right = len(numbers) - 1
operations = 0

while left <= right:

    operations += 1

    middle = (left + right) // 2

    if numbers[middle] == target:
        print("Target found!")
        print("Index:", middle)
        print("Operations:", operations)
        break

    elif target < numbers[middle]:
        right = middle - 1

    else:
        left = middle + 1

else:
    print("Target not found.")
    print("Index: -1")
    print("Operations:", operations)